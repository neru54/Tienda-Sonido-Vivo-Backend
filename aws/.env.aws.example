# ---------------------------------------------------------------
# .env del servidor cuando la base es Amazon RDS (usar con aws/compose.rds.yaml).
# Copiar como .env en la raíz del repositorio en el servidor. NUNCA subirlo a git.
# Los secretos se generan igual que en .env.example.
# ---------------------------------------------------------------

JWT_SECRET=REEMPLAZAR_CON_openssl_rand_-base64_48
JWT_EXPIRACION_MINUTOS=120
INTERNAL_API_KEY=REEMPLAZAR_CON_openssl_rand_-hex_32

# Endpoint de RDS (RDS > Bases de datos > sonido-vivo-mysql > Conectividad > Punto de enlace)
DB_HOST=sonido-vivo-mysql.REEMPLAZAR.us-east-1.rds.amazonaws.com
DB_PORT=3306

# Deben coincidir con las contraseñas que pusiste en sql/01_crear_esquemas_mysql.sql
DB_USUARIOS_USER=sv_usuarios
DB_USUARIOS_PASSWORD=REEMPLAZAR_usuarios
DB_CATALOGO_USER=sv_catalogo
DB_CATALOGO_PASSWORD=REEMPLAZAR_catalogo
DB_PEDIDOS_USER=sv_pedidos
DB_PEDIDOS_PASSWORD=REEMPLAZAR_pedidos

# Orígenes permitidos por el Gateway: el sitio S3 (y localhost para pruebas)
CORS_ORIGINS=http://localhost:5173,http://REEMPLAZAR-bucket.s3-website-us-east-1.amazonaws.com

DDL_AUTO=update
