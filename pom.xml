<?xml version="1.0" encoding="UTF-8"?>
<!--
  POM padre (multimódulo) del backend de Sonido Vivo en microservicios.

  - common ..... biblioteca compartida (errores, JWT, OpenAPI). NO es un microservicio.
  - usuarios ... 8081, esquema sonido_usuarios (emite el JWT)
  - catalogo ... 8082, esquema sonido_catalogo (categorías, productos y stock)
  - pedidos .... 8083, esquema sonido_pedidos (boletas y reportes)
  - gateway .... 8080, punto de entrada del frontend (sin base de datos)

  Un solo "./mvnw verify" desde esta carpeta compila, prueba y empaqueta todo.
  Las versiones de Spring Boot y Spring Cloud se fijan aquí para que todos los módulos usen las mismas.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.5.13</version>
		<relativePath/>
	</parent>

	<groupId>cl.sonidovivo</groupId>
	<artifactId>sonido-vivo-backend</artifactId>
	<version>1.0.0</version>
	<packaging>pom</packaging>
	<name>Sonido Vivo - Backend de microservicios</name>

	<properties>
		<java.version>21</java.version>
		<!-- release=21: aunque se compile con un JDK más nuevo, el bytecode y la API quedan en Java 21 -->
		<maven.compiler.release>21</maven.compiler.release>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<spring-cloud.version>2025.0.0</spring-cloud.version>
		<springdoc.version>2.8.17</springdoc.version>
		<jjwt.version>0.12.6</jjwt.version>
		<jacoco.version>0.8.15</jacoco.version>
	</properties>

	<modules>
		<module>common</module>
	</modules>

	<dependencyManagement>
		<dependencies>
			<!-- BOM de Spring Cloud (Gateway) compatible con Spring Boot 3.5 -->
			<dependency>
				<groupId>org.springframework.cloud</groupId>
				<artifactId>spring-cloud-dependencies</artifactId>
				<version>${spring-cloud.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
			<dependency>
				<groupId>cl.sonidovivo</groupId>
				<artifactId>common</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>org.springdoc</groupId>
				<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
				<version>${springdoc.version}</version>
			</dependency>
			<dependency>
				<groupId>org.springdoc</groupId>
				<artifactId>springdoc-openapi-starter-webflux-ui</artifactId>
				<version>${springdoc.version}</version>
			</dependency>
			<dependency>
				<groupId>io.jsonwebtoken</groupId>
				<artifactId>jjwt-api</artifactId>
				<version>${jjwt.version}</version>
			</dependency>
			<dependency>
				<groupId>io.jsonwebtoken</groupId>
				<artifactId>jjwt-impl</artifactId>
				<version>${jjwt.version}</version>
			</dependency>
			<dependency>
				<groupId>io.jsonwebtoken</groupId>
				<artifactId>jjwt-jackson</artifactId>
				<version>${jjwt.version}</version>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<build>
		<pluginManagement>
			<plugins>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-surefire-plugin</artifactId>
					<configuration>
						<!--
						  @{argLine} lo completa JaCoCo con su agente. byte-buddy (usado por Mockito)
						  necesita el modo experimental cuando las pruebas corren en un JDK más nuevo que 21.
						-->
						<argLine>@{argLine} -Dnet.bytebuddy.experimental=true -XX:+EnableDynamicAgentLoading</argLine>
					</configuration>
				</plugin>
			</plugins>
		</pluginManagement>
		<plugins>
			<!-- Cobertura: prepare-agent antes de las pruebas y reporte HTML en target/site/jacoco -->
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<version>${jacoco.version}</version>
				<executions>
					<execution>
						<id>preparar-agente</id>
						<goals>
							<goal>prepare-agent</goal>
						</goals>
					</execution>
					<execution>
						<id>reporte</id>
						<phase>verify</phase>
						<goals>
							<goal>report</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
