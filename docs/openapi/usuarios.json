{"openapi":"3.1.0","info":{"title":"Sonido Vivo - Usuarios","description":"Cuentas, login, registro de clientes y emisión del JWT. Obtén el token en POST /api/v1/auth/login y úsalo con Authorize.","contact":{"name":"Equipo Sonido Vivo - DSY1104"},"version":"v1"},"servers":[{"url":"/","description":"Servidor actual (Gateway o servicio directo)"}],"tags":[{"name":"Autenticación","description":"Login, registro de clientes y datos de la sesión"},{"name":"Usuarios","description":"CRUD solo Administrador; /me para la propia cuenta"}],"paths":{"/api/v1/usuarios/{run}":{"get":{"tags":["Usuarios"],"summary":"Detalle de un usuario","description":"Solo Administrador.","operationId":"obtener","parameters":[{"name":"run","in":"path","required":true,"schema":{"type":"string"}}],"responses":{"404":{"description":"No existe","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ErrorRespuesta"}}}}},"security":[{"bearerAuth":[]}]},"put":{"tags":["Usuarios"],"summary":"Actualizar usuario","description":"Contraseña vacía = se conserva. Solo Administrador.","operationId":"actualizar","parameters":[{"name":"run","in":"path","required":true,"schema":{"type":"string"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/UsuarioRequest"}}},"required":true},"responses":{"409":{"description":"Correo usado por otro usuario","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ErrorRespuesta"}}}}},"security":[{"bearerAuth":[]}]},"delete":{"tags":["Usuarios"],"summary":"Eliminar usuario","description":"No permite eliminarse a sí mismo; sus boletas se conservan con su RUN. Solo Administrador.","operationId":"eliminar","parameters":[{"name":"run","in":"path","required":true,"schema":{"type":"string"}}],"responses":{"204":{"description":"Eliminado"},"409":{"description":"Intento de eliminar la propia cuenta","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ErrorRespuesta"}}}}},"security":[{"bearerAuth":[]}]}},"/api/v1/usuarios/me":{"get":{"tags":["Usuarios"],"summary":"Mi perfil","description":"Administrador o Cliente.","operationId":"miPerfil","responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/UsuarioResponse"}}}}},"security":[{"bearerAuth":[]}]},"put":{"tags":["Usuarios"],"summary":"Actualizar mi perfil","description":"No permite cambiar RUN, correo ni tipo de usuario.","operationId":"actualizarPerfil","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/PerfilRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/UsuarioResponse"}}}}},"security":[{"bearerAuth":[]}]}},"/api/v1/usuarios":{"get":{"tags":["Usuarios"],"summary":"Listar usuarios","description":"Solo Administrador.","operationId":"listar","responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/UsuarioResponse"}}}}}},"security":[{"bearerAuth":[]}]},"post":{"tags":["Usuarios"],"summary":"Crear usuario","description":"Cualquier rol. Solo Administrador.","operationId":"crear","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/UsuarioRequest"}}},"required":true},"responses":{"201":{"description":"Creado","content":{"*/*":{"schema":{"$ref":"#/components/schemas/UsuarioResponse"}}}},"409":{"description":"RUN o correo repetido","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ErrorRespuesta"}}}}},"security":[{"bearerAuth":[]}]}},"/api/v1/auth/registro":{"post":{"tags":["Autenticación"],"summary":"Registrarse como cliente","description":"Crea una cuenta con rol Cliente e inicia la sesión. Público.","operationId":"registrar","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/RegistroRequest"}}},"required":true},"responses":{"201":{"description":"Cuenta creada","content":{"*/*":{"schema":{"$ref":"#/components/schemas/AuthResponse"}}}},"400":{"description":"Datos inválidos (RUN, correo, contraseña...)","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ErrorRespuesta"}}}},"409":{"description":"RUN o correo ya registrados","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ErrorRespuesta"}}}}}}},"/api/v1/auth/login":{"post":{"tags":["Autenticación"],"summary":"Iniciar sesión","description":"Devuelve un JWT (2 horas por defecto) y los datos del usuario. Público.","operationId":"login","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/LoginRequest"}}},"required":true},"responses":{"200":{"description":"Credenciales correctas","content":{"*/*":{"schema":{"$ref":"#/components/schemas/AuthResponse"}}}},"401":{"description":"Correo o contraseña incorrectos","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ErrorRespuesta"}}}}}}},"/api/v1/auth/me":{"get":{"tags":["Autenticación"],"summary":"Usuario de la sesión","description":"Datos del dueño del token. Requiere estar autenticado (cualquier rol).","operationId":"yo","responses":{"401":{"description":"Sin token o token vencido","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ErrorRespuesta"}}}}},"security":[{"bearerAuth":[]}]}}},"components":{"schemas":{"UsuarioRequest":{"type":"object","description":"Datos de usuario para el panel de administración","properties":{"run":{"type":"string","example":"12345678-5","minLength":1,"pattern":"^[0-9]{6,8}-[0-9kK]$"},"nombre":{"type":"string","example":"Pedro","maxLength":50,"minLength":0},"apellidos":{"type":"string","example":"Díaz","maxLength":100,"minLength":0},"correo":{"type":"string","example":"pedro.diaz@duoc.cl","maxLength":100,"minLength":0,"pattern":"(?i)^[^\\s@]+@(duoc\\.cl|profesor\\.duoc\\.cl|gmail\\.com)$"},"password":{"type":"string","description":"Obligatoria al crear; opcional al editar","example":"vend123","maxLength":10,"minLength":0},"fechaNacimiento":{"type":"string","format":"date"},"tipoUsuario":{"type":"string","enum":["Administrador","Vendedor","Cliente"],"example":"Vendedor"},"region":{"type":"string","minLength":1},"comuna":{"type":"string","minLength":1},"direccion":{"type":"string","maxLength":300,"minLength":0}},"required":["apellidos","comuna","correo","direccion","nombre","region","run","tipoUsuario"]},"ErrorRespuesta":{"type":"object","description":"Respuesta de error","properties":{"fecha":{"type":"string","format":"date-time","example":"2026-11-06T15:00:00Z"},"estado":{"type":"integer","format":"int32","example":409},"error":{"type":"string","example":"Conflict"},"mensaje":{"type":"string","example":"Ya existe un producto con ese código."},"ruta":{"type":"string","example":"/api/v1/productos"},"errores":{"type":"object","additionalProperties":{"type":"string"},"description":"Errores por campo (solo en validaciones)"}}},"PerfilRequest":{"type":"object","description":"Datos editables del propio perfil","properties":{"nombre":{"type":"string","maxLength":50,"minLength":0},"apellidos":{"type":"string","maxLength":100,"minLength":0},"password":{"type":"string","description":"Opcional: si viene vacía se conserva la actual","maxLength":10,"minLength":0},"fechaNacimiento":{"type":"string","format":"date"},"region":{"type":"string","minLength":1},"comuna":{"type":"string","minLength":1},"direccion":{"type":"string","maxLength":300,"minLength":0}},"required":["apellidos","comuna","direccion","nombre","region"]},"UsuarioResponse":{"type":"object","description":"Usuario (sin contraseña)","properties":{"run":{"type":"string","example":"11111111-1"},"nombre":{"type":"string","example":"María"},"apellidos":{"type":"string","example":"Pérez Soto"},"correo":{"type":"string","example":"maria.perez@gmail.com"},"fechaNacimiento":{"type":"string","format":"date"},"tipoUsuario":{"type":"string","enum":["Administrador","Vendedor","Cliente"],"example":"Administrador"},"region":{"type":"string"},"comuna":{"type":"string"},"direccion":{"type":"string"}}},"RegistroRequest":{"type":"object","description":"Datos para crear una cuenta de cliente desde la tienda","properties":{"run":{"type":"string","example":"12345678-5","minLength":1,"pattern":"^[0-9]{6,8}-[0-9kK]$"},"nombre":{"type":"string","example":"Ana","maxLength":50,"minLength":0},"apellidos":{"type":"string","example":"Soto Díaz","maxLength":100,"minLength":0},"correo":{"type":"string","example":"ana.soto@gmail.com","maxLength":100,"minLength":0,"pattern":"(?i)^[^\\s@]+@(duoc\\.cl|profesor\\.duoc\\.cl|gmail\\.com)$"},"password":{"type":"string","example":"abcd1234","maxLength":10,"minLength":4},"region":{"type":"string","example":"Región de Valparaíso","minLength":1},"comuna":{"type":"string","example":"Quilpué","minLength":1},"direccion":{"type":"string","example":"Los Carrera 123","maxLength":300,"minLength":0},"fechaNacimiento":{"type":"string","format":"date","example":"2000-01-31"}},"required":["apellidos","comuna","correo","direccion","nombre","password","region","run"]},"AuthResponse":{"type":"object","description":"Token JWT y datos del usuario autenticado","properties":{"token":{"type":"string","description":"JWT a enviar en el encabezado Authorization: Bearer <token>"},"tipo":{"type":"string","example":"Bearer"},"expiraEn":{"type":"string","format":"date-time","description":"Fecha y hora en que el token deja de ser válido"},"usuario":{"$ref":"#/components/schemas/UsuarioResponse"}}},"LoginRequest":{"type":"object","description":"Credenciales para iniciar sesión","properties":{"correo":{"type":"string","example":"maria.perez@gmail.com","minLength":1},"password":{"type":"string","example":"admin123","minLength":1}},"required":["correo","password"]}},"securitySchemes":{"bearerAuth":{"type":"http","scheme":"bearer","bearerFormat":"JWT"}}}}