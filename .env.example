# ---------------------------------------------------------------
# Variables de entorno del backend de microservicios (EJEMPLO).
# Copia este archivo como .env y reemplaza TODOS los valores.
# El .env real nunca se sube a git (está en .gitignore).
# ---------------------------------------------------------------

# JWT HS256: secreto COMPARTIDO por usuarios (firma) y catalogo/pedidos (validan).
# Base64 de al menos 32 bytes. Genéralo con:  openssl rand -base64 48
JWT_SECRET=REEMPLAZAR_CON_openssl_rand_-base64_48
JWT_EXPIRACION_MINUTOS=120

# Clave de servicio para la llamada interna pedidos -> catalogo (/internal/**).
# Genérala con:  openssl rand -hex 32
INTERNAL_API_KEY=REEMPLAZAR_CON_openssl_rand_-hex_32

# Orígenes del frontend permitidos por CORS en el Gateway (separados por coma).
# En AWS agrega la URL del sitio S3, por ejemplo http://mi-bucket.s3-website-us-east-1.amazonaws.com
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# MySQL: una instancia con 3 esquemas; cada microservicio usa su propio usuario.
# Contraseña de root (solo la usa el contenedor MySQL de compose.yaml)
MYSQL_ROOT_PASSWORD=REEMPLAZAR_root

# Host de MySQL: "mysql" dentro de compose; el endpoint de RDS en AWS; localhost en local.
DB_HOST=mysql
DB_PORT=3306

DB_USUARIOS_USER=sv_usuarios
DB_USUARIOS_PASSWORD=REEMPLAZAR_usuarios
DB_CATALOGO_USER=sv_catalogo
DB_CATALOGO_PASSWORD=REEMPLAZAR_catalogo
DB_PEDIDOS_USER=sv_pedidos
DB_PEDIDOS_PASSWORD=REEMPLAZAR_pedidos

# update crea/ajusta tablas en el primer arranque; después se recomienda validate.
DDL_AUTO=update
